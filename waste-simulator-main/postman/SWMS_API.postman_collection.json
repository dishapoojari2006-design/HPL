{"info":{"name":"SWMS API","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"item":[{"name":"01 Health","item":[{"name":"Health","request":{"method":"GET","url":"{{baseUrl}}/health"},"event":[{"listen":"test","script":{"exec":["pm.test('healthy',()=>pm.response.to.have.status(200));","pm.test('json',()=>pm.response.to.be.json);"]}}]}]},{"name":"02 Authentication","item":[{"name":"Register","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"Administrator\",\"email\":\"admin@example.com\",\"password\":\"verysecurepass\",\"role\":\"SUPER_ADMIN\"}"},"url":"{{baseUrl}}/auth/register"}},{"name":"Login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"admin@example.com\",\"password\":\"verysecurepass\"}"},"url":"{{baseUrl}}/auth/login"},"event":[{"listen":"test","script":{"exec":["pm.test('token returned',()=>pm.expect(pm.response.json()).to.have.property('access_token'));","pm.environment.set('token',pm.response.json().access_token);"]}}]}]},{"name":"03 Locations","item":[{"name":"Create location","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"Udupi Demo\",\"location_type\":\"Gram Panchayat\",\"latitude\":13.3409,\"longitude\":74.7421}"},"url":"{{baseUrl}}/locations"},"event":[{"listen":"test","script":{"exec":["pm.test('created',()=>pm.response.to.have.status(201));","pm.environment.set('locationId',pm.response.json().id);"]}}]}]},{"name":"13 Waste Calculation","item":[{"name":"Calculate waste","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"parameters\":{\"model\":\"PERSON\",\"total_population\":10000,\"waste_per_person_per_day\":0.5}}"},"url":"{{baseUrl}}/calculations/waste"}}]},{"name":"21 Simulation","item":[{"name":"Run simulation","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"location_id\":{{locationId}},\"years\":20,\"parameters\":{\"total_population\":10000,\"waste_per_person_per_day\":0.5,\"population_growth_rate\":2}}"},"url":"{{baseUrl}}/simulations"},"event":[{"listen":"test","script":{"exec":["pm.test('results returned',()=>pm.expect(pm.response.json()).to.have.property('simulation_id'));"]}}]}]}]}
